{
  "files.associations": {
    "*.css": "tailwindcss",
    "*.scss": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.classAttributes": ["active-class", "class", "inactive-class", "ui"],
  "tailwindCSS.experimental.classRegex": [
    ["ui:\\s*{([^)]*)\\s*}", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["bodyAttrs:\\s*{[^}]*class:\\s*['\"`]([^'\"`]*)['\"`]", "([^ ]*)"]
  ]
}
